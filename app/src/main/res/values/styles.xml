<resources>
    <style name="Theme.Nuvio" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#26DDD2</item>
        <item name="android:windowBackground">#101421</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#101421</item>
        <item name="android:statusBarColor">#101421</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="NuvioButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/tv_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
