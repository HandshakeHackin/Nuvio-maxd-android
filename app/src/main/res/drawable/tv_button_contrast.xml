<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#222222" /><stroke android:width="4dp" android:color="#FFFFFF" /><corners android:radius="8dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#444444" /><stroke android:width="2dp" android:color="#FFFFFF" /></shape></item>
    <item><shape><solid android:color="#000000" /><stroke android:width="2dp" android:color="#AAAAAA" /><corners android:radius="8dp" /></shape></item>
</selector>
